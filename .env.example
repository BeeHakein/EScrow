# Copy to .env (gitignored) and fill in. NEVER commit real secrets.
# .env is already in .gitignore; this .example file is safe to commit.

# ─── Chain adapters (Base Sepolia testnet, chainId 84532) ───────────────────────
# RPC endpoint. Free public option below, or an Alchemy/Infura URL for reliability.
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
# A THROWAWAY test wallet private key, funded with Base Sepolia ETH from a faucet
# (e.g. https://www.alchemy.com/faucets/base-sepolia). 0x-prefixed, 64 hex chars.
# ⚠️ Use a disposable key only — never a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY="0x..."
# ERC-20 the escrow is denominated in. Leave blank to deploy the MockERC20 for testing.
ESCROW_TOKEN_ADDRESS=""
# Address of the deployed ReportAnchor contract (set after first deploy).
REPORT_ANCHOR_ADDRESS=""

# ─── AI (analyzer live-API verify) ──────────────────────────────────────────────
# Needed only to verify ClaudeContractAnalyzer against the real API (one billed call).
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Database (Prisma) ──────────────────────────────────────────────────────────
# The COMMITTED prisma/schema.prisma uses the sqlite provider so the test gate stays offline
# and deterministic (each test file spins up a throwaway sqlite DB with the migrations applied).
# Local dev / migrations: point at a sqlite file (path is relative to prisma/).
DATABASE_URL="file:./dev.db"
# Production target is Postgres: flip the datasource `provider` in schema.prisma to "postgresql",
# set the URL below, then `prisma migrate deploy`. The models are provider-portable (no Json
# columns; wei + the status/state unions are stored as TEXT), so they need no changes.
# DATABASE_URL="postgresql://user:password@localhost:5432/newera?schema=public"
